Card 9:
if (keyboard(SDL_SCANCODE_RIGHT))
{
   player.rect.x += player.speed * deltaTime;
}
--
If right arrow is held, move player right.
Movement uses speed times deltaTime.

Card 10:
Uint64 previousTime = SDL_GetTicks();
--
Stores previous frame time in milliseconds.

Card 11:
Uint64 frameStart = SDL_GetTicks();
--
Gets current frame start time in milliseconds.

Card 12:
float deltaTime = (frameStart - previousTime) / 1000.0f;
previousTime = frameStart;
--
Calculates seconds since last frame.
Converts milliseconds to seconds.

Card 13:
player.rect.x += player.speed * deltaTime;
--
Moves based on real time, not frame count.
speed is pixels per second.

Card 14:
const int targetFPS = 60;
const Uint64 frameDelayMS = 1000 / targetFPS;
--
At 60 FPS, each frame should take about 16 ms.

Card 15:
if (frameTime < frameDelayMS)
{
   SDL_Delay(frameDelayMS - frameTime)
}
--
If the frame finished too fast, wait.
Controls max frame rate.

